# ==============================================================================
# Orchestrail - Local Development Environment Variables
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Application environment and API server configuration
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (postgres:18.6-alpine)
# ------------------------------------------------------------------------------
POSTGRES_USER=orchestrail_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=orchestrail_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Configuration (redis:8.10.3-alpine)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Application Connection URLs (Documented for upcoming milestones)
# ------------------------------------------------------------------------------
# For host applications (running locally on developer's machine):
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}
#
# For container-to-container communication (running inside Docker network):
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
