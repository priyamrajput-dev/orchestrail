# Orchestrail root .gitignore
# Covers Bun/Turborepo monorepo, Next.js, Drizzle, Docker, and future Python AI service.

# Dependencies
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lockb

# Environment and local secrets
.env
.env.*
!.env.example
!.env.*.example
.envrc
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build and generated output
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
*.lcov
.turbo/
.vercel

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Turbo / tooling caches
.cache/
.eslintcache
*.eslintcache

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Editors and IDEs
.idea/
.vscode/
*.iml

# Certificates and private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Docker / local infrastructure data
postgres-data/
redis-data/
docker-data/
*.pid
*.sock

# Python (ai service)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Archives and package tarballs
*.tgz
*.tar.gz

# Next.js generated types (regenerated on build/dev)
**/next-env.d.ts

# Temporary files
tmp/
temp/
*.tmp


